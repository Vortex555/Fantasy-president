# --- How the game thinks -----------------------------------------------------
#
# Three options, in order of what they cost you.
#
#  1. Nothing at all. Leave everything below unset and the game runs its
#     built-in engine offline. Fully playable; the reactions are shallower.
#
#  2. A model on your own machine. Free, private, and slower — see below.
#
#  3. Anthropic's API. The best writing, at roughly 80 cents for a full
#     48-month term. Set ANTHROPIC_API_KEY and nothing else.

# --- Option 3: the hosted API ------------------------------------------------
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# The judge (consequences, checks and balances) and the flavour (voter quotes,
# advisor chat, debate rounds). Two tiers because the flavour does not need the
# expensive model.
# FP_MODEL=claude-sonnet-5
# FP_CHAT_MODEL=claude-haiku-4-5

# --- Option 2: a model on this machine ---------------------------------------
#
# Works with anything that speaks the OpenAI chat-completions API, which is all
# of the usual runners:
#
#   Ollama      ollama serve            http://localhost:11434/v1   (the default)
#   LM Studio   start the local server  http://localhost:1234/v1
#   llama.cpp   llama-server            http://localhost:8080/v1
#   vLLM        vllm serve              http://localhost:8000/v1
#
# Quickest start, from nothing:
#   brew install ollama && ollama serve
#   ollama pull qwen2.5:7b
#   FP_PROVIDER=local npm start
#
# FP_PROVIDER=local

# Where the server is. Defaults to Ollama's address.
# FP_LOCAL_URL=http://localhost:11434/v1

# Which model. Leave unset and the game asks the server what it has loaded and
# uses the first one, so pulling a model is usually the only step.
# FP_LOCAL_MODEL=qwen2.5:7b
# FP_LOCAL_CHAT_MODEL=llama3.2:3b

# Some servers want a bearer token and do not care what it is.
# FP_LOCAL_KEY=local

# A 7B on CPU can take minutes on a long structured answer. Three minutes by
# default so a slow machine reads as slow rather than broken.
# FP_LOCAL_TIMEOUT_MS=180000

# --- The rest ----------------------------------------------------------------
# PORT=3000
