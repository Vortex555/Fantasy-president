# Copy to ".env" (or export these in your shell) to enable live AI turns.
#
# Your Anthropic API key. Get one at https://console.anthropic.com/
# Without it, the game runs on a built-in local simulation instead.
ANTHROPIC_API_KEY=

# Optional: model for the main monthly simulation (defaults to claude-opus-4-8).
# FP_MODEL=claude-opus-4-8

# Optional: cheaper model for advisor chat + opening crises (defaults to Haiku).
# This is the main cost lever — the many small calls run here, not on Opus.
# FP_CHAT_MODEL=claude-haiku-4-5

# Optional: server port (defaults to 3000).
# PORT=3000
